{
  "$schema": "https://turbo.build/schema.json",

  "globalDependencies": ["**/.env.*local", ".env"],

  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DIRECT_URL",
    "REDIS_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "TOLGEE_API_KEY",
    "SENTRY_DSN",
    "NOTIFICATION_DELIVERY_ENABLED",
    "EMAIL_PROVIDER",
    "QOE_PUBLIC_URL"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!**/*.spec.*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },

    "clean": {
      "cache": false
    },

    "docker:dev": {
      "cache": false,
      "persistent": true
    },

    "docker:prod": {
      "cache": false,
      "persistent": true
    }
  }
}
