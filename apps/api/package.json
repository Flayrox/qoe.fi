{
  "name": "@qoe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API (Hono) — serves /api.qoe.fi (webhooks, tRPC, public API)",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "@qoe/analytics": "workspace:*",
    "@qoe/billing": "workspace:*",
    "@qoe/config": "workspace:*",
    "@qoe/db": "workspace:*",
    "@qoe/observability": "workspace:^",
    "@qoe/supabase": "workspace:*",
    "@qoe/utils": "workspace:*",
    "@supabase/supabase-js": "^2.105.4",
    "bullmq": "^5.79.3",
    "hono": "^4.6.14",
    "ioredis": "^5.11.1",
    "meilisearch": "^0.44.0",
    "stripe": "^17.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@qoe/tsconfig": "workspace:*",
    "@types/node": "^20",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
