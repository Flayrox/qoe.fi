{
  "extends": "@qoe/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@qoe/config": ["../../packages/config/src/index.ts"],
      "@qoe/config/*": ["../../packages/config/src/*"],
      "@qoe/api-client": ["../../packages/api-client/src/index.ts"],
      "@qoe/api-client/*": ["../../packages/api-client/src/*"],
      "@qoe/supabase": ["../../packages/supabase/src/index.ts"],
      "@qoe/supabase/*": ["../../packages/supabase/src/*"],
      "@qoe/utils": ["../../packages/utils/src/index.ts"],
      "@qoe/utils/*": ["../../packages/utils/src/*"],
      "@qoe/ui": ["../../packages/ui/src/index.ts"],
      "@qoe/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
