{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Les tests « wiring » lisent les sources avec `node:fs` / `node:url`.
    // TypeScript 6 n'ajoute plus les types Node implicitement.
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": [
    "expo-env.d.ts",
    "*.ts",
    "*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.ts",
    "modules/**/*.tsx"
  ]
}
