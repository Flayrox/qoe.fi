# =====================================================================
# ⚙️ .npmrc — Configuration pnpm pour le monorepo qoe.fi
# =====================================================================
# 📖 Ce fichier configure le comportement de pnpm dans tout le repo.
#    Il est lu AVANT l'installation des dépendances.
# =====================================================================

# 🔒 Mode strict : bloque l'accès aux deps non déclarées
#    Empêche d'importer un package qu'on a oublié d'ajouter au package.json
strict-peer-dependencies=false

# 🚫 Empêche pnpm d'élever les scripts post-install pour la sécurité
#    (évite les supply chain attacks)
enable-pre-post-scripts=false

# 🔗 Mode d'installation : hoisted (flat node_modules)
#    En mode isolated (défaut pnpm), les symlinks pointent vers le store
#    central. Dans Docker avec workspaces, ça peut casser les liens
#    et causer "Cannot find module". Le mode hoisted est plus simple
#    et plus compatible avec Docker.
#    Pour le dev local (ton PC), isolated reste OK car pnpm résout
#    correctement via le store central. Mais pour Docker : hoisted.
node-linker=hoisted

# 📦 Auto-install des peers (utile pour React 19, Next.js, etc.)
auto-install-peers=true

# ⚡ Économie disque : packages hoistés dans un store central
#    Chaque workspace a son propre node_modules virtuel via des symlinks
prefer-workspace-packages=true

# 📚 Link du workspace bin (permet `pnpm turbo` de fonctionner)
link-workspace-packages=true

# 🛡️ Vérifie que les versions exactes correspondent au lockfile
#    Évite les surprises entre dev et prod
frozen-lockfile=false

# 📂 Force la copie des packages (évite les erreurs EXDEV / ENOENT de liens physiques sur Windows/Docker)
package-import-method=copy
