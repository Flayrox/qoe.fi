# =====================================================================
# 🐳 .env.docker.example — Template des variables d'environnement Docker
# =====================================================================
# 📋 INSTRUCTIONS :
# 1. Copie ce fichier : `cp .env.docker.example .env.docker`
# 2. Remplis les valeurs avec tes vrais secrets
# 3. Le fichier `.env.docker` est IGNORÉ par git (jamais commité)
# 4. Lance : `docker compose --env-file .env.docker up`
# =====================================================================

# ---------------------------------------------------------------------
# 🗄️  BASE DE DONNÉES (PostgreSQL interne à Docker)
# ---------------------------------------------------------------------
# Ces valeurs sont utilisées par docker-compose pour créer la DB locale.
# Le service "db" sera accessible depuis l'app via le hostname "db".

POSTGRES_USER=qoe
POSTGRES_PASSWORD=change_me_in_prod_use_a_strong_password
POSTGRES_DB=qoe

# ⚠️ NE PAS UTILISER CES VALEURS EN PRODUCTION !
# Génère un mot de passe fort : `openssl rand -base64 32`

# ---------------------------------------------------------------------
# 🔗  URLS PRISMA (utilisées par l'app Next.js)
# ---------------------------------------------------------------------
# DATABASE_URL : avec connection pooling (port 6543 si tu utilises Supabase, ou 5432 en local Docker)
# DIRECT_URL   : connexion directe pour les migrations (toujours port 5432)

# En Docker LOCAL (db interne), les deux pointent sur le service "db"
DATABASE_URL=postgresql://qoe:change_me_in_prod_use_a_strong_password@db:5432/qoe?schema=public
DIRECT_URL=postgresql://qoe:change_me_in_prod_use_a_strong_password@db:5432/qoe?schema=public

# En PROD (si tu utilises Supabase externe pour la DB, ce qui n'est pas ton cas actuel)
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------
# 🔐  SUPABASE (externe, hébergé par Supabase Cloud)
# ---------------------------------------------------------------------
# 🔐  SUPABASE — Self-hosted local (recommandé, pas de cloud)
# ---------------------------------------------------------------------
# Le stack Supabase self-hosté tourne à côté (docker-compose séparé,
# réseau `supabase_default`). Les URLs publiques sont exposées via Caddy :
#   auth.qoe.fi  → Kong (Auth REST / gotrue / storage)
#   cdn.qoe.fi   → Storage (CDN local)
# Les clés anon/service_role proviennent de votre stack local (voir le
# fichier .env du stack Supabase : SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=https://auth.qoe.fi
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...votre-annee-cle-locale
SUPABASE_SERVICE_ROLE_KEY=eyJ...votre-service-role-cle-locale

# ⚠️ Alternative Cloud (si vous préférez) :
# NEXT_PUBLIC_SUPABASE_URL=https://ton-projet.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------
# 🌐  NEXTAUTH / APP
# ---------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

# URL publique de l'app (utilisée pour les redirects OAuth, emails, etc.)
NEXT_PUBLIC_APP_URL=http://qoe.localhost
NEXT_PUBLIC_CONSOLE_URL=http://qoe.localhost
NEXT_PUBLIC_LANDING_URL=http://hi.localhost
NEXT_PUBLIC_API_URL=http://api.localhost
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost
NEXT_PUBLIC_DASHBOARD_URL=http://dashboard.localhost
# Backend-of-record Go (réseau privé Docker, jamais public).
# En prod (Docker) : http://api:8080 — service compose `api` (qoefi-api).
# En dev local : http://localhost:8090. Vide = Go désactivé (fallback Prisma).
QOE_API_URL=http://api:8080
# En prod : NEXT_PUBLIC_APP_URL=https://qoe.fi

# ---------------------------------------------------------------------
# 💳  STRIPE (paiements)
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

DEFAULT_LANGUAGE=fr

# ---------------------------------------------------------------------
# 🤖  IA (optionnel — pour les features d'IA dans ton app)
# ---------------------------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------
# 🐘  POSTGRES (paramètres additionnels pour le service db)
# ---------------------------------------------------------------------
# Active l'extension pgvector dès le démarrage
POSTGRES_INITDB_ARGS=--encoding=UTF-8 --lc-collate=C --lc-ctype=C

# ---------------------------------------------------------------------
# 📊  UMAMI ANALYTICS (Télémétrie Créateurs & Blogs — Cookie-less)
# Umami self-hosté (service docker-compose) — pas de clé cloud payante.
# UMAMI_API_URL est fixé à http://umami:3000/api dans docker-compose.
# Auth self-hosted v2 : login → token (recommandé) :
UMAMI_USERNAME=admin
UMAMI_PASSWORD=umami
# Ou API key cloud (si vous utilisez Umami Cloud) :
UMAMI_API_KEY=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.qoe.fi/script.js
# Salt de hachage Umami (changez-le !)
UMAMI_HASH_SALT=qoe_umami_salt_please_change



# ---------------------------------------------------------------------
# 🪟 SENTRY (Observabilité / Erreurs)
# ---------------------------------------------------------------------
# DSN public de ton projet Sentry. Laisse vide en dev local → no-op silencieux.
SENTRY_DSN=

# ---------------------------------------------------------------------
# 🚩 GROWTHBOOK (Feature Flags — self-hosté en dev, voir docker-compose.dev.yml)
# ---------------------------------------------------------------------
# UI : http://localhost:3100 · API SDK : http://localhost:3200
# Après le 1er `docker compose ... up`, ouvre l'UI, crée ton compte admin,
# puis Settings → SDK Connections → New SDK Connection → copie la clé `sdk-...`.
#
# GROWTHBOOK_API_HOST    : URL de l'API SDK côté serveur (SSR, API, workers)
# GROWTHBOOK_CLIENT_KEY  : clé SDK (serveur) — lire dans GrowthBook UI
# NEXT_PUBLIC_GROWTHBOOK_API_HOST  : même URL, exposée au navigateur
# NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY: même clé, exposée au navigateur (SDK public)
GROWTHBOOK_API_HOST=http://localhost:3200
GROWTHBOOK_CLIENT_KEY=sdk-...   # ← remplace par ta clé réelle
NEXT_PUBLIC_GROWTHBOOK_API_HOST=http://localhost:3200
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=sdk-...   # ← remplace par ta clé réelle
