# =====================================================================
# 🐳 .env.docker.example — Template des variables d'environnement Docker
# =====================================================================
# 📋 INSTRUCTIONS :
# 1. Copie ce fichier : `cp .env.docker.example .env.docker`
# 2. Remplis les valeurs avec tes vrais secrets
# 3. Le fichier `.env.docker` est IGNORÉ par git (jamais commité)
# 4. Lance : `docker compose --env-file .env.docker up`
# =====================================================================

# ---------------------------------------------------------------------
# 🗄️  BASE DE DONNÉES (PostgreSQL interne à Docker)
# ---------------------------------------------------------------------
# Ces valeurs sont utilisées par docker-compose pour créer la DB locale.
# Le service "db" sera accessible depuis l'app via le hostname "db".

POSTGRES_USER=qoe
POSTGRES_PASSWORD=change_me_in_prod_use_a_strong_password
POSTGRES_DB=qoe

# ⚠️ NE PAS UTILISER CES VALEURS EN PRODUCTION !
# Génère un mot de passe fort : `openssl rand -base64 32`

# ---------------------------------------------------------------------
# 🔗  URLS PRISMA (utilisées par l'app Next.js)
# ---------------------------------------------------------------------
# DATABASE_URL : avec connection pooling (port 6543 si tu utilises Supabase, ou 5432 en local Docker)
# DIRECT_URL   : connexion directe pour les migrations (toujours port 5432)

# En Docker LOCAL (db interne), les deux pointent sur le service "db"
DATABASE_URL=postgresql://qoe:change_me_in_prod_use_a_strong_password@db:5432/qoe?schema=public
DIRECT_URL=postgresql://qoe:change_me_in_prod_use_a_strong_password@db:5432/qoe?schema=public

# En PROD (si tu utilises Supabase externe pour la DB, ce qui n'est pas ton cas actuel)
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------
# 🔐  SUPABASE (externe, hébergé par Supabase Cloud)
# ---------------------------------------------------------------------
# Tu utilises Supabase Cloud pour Auth/Storage/Realtime.
# Ces valeurs sont dans : Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://ton-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------
# 🌐  NEXTAUTH / APP
# ---------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

# URL publique de l'app (utilisée pour les redirects OAuth, emails, etc.)
NEXT_PUBLIC_APP_URL=http://qoe.localhost
NEXT_PUBLIC_CONSOLE_URL=http://qoe.localhost
NEXT_PUBLIC_LANDING_URL=http://start.localhost
NEXT_PUBLIC_API_URL=http://api.localhost
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost
NEXT_PUBLIC_DASHBOARD_URL=http://dashboard.localhost
# En prod : NEXT_PUBLIC_APP_URL=https://qoe.fi

# ---------------------------------------------------------------------
# 💳  STRIPE (paiements)
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------------------------------------------------------------------
# 🌍  I18N / TOLGEE
# ---------------------------------------------------------------------
NEXT_PUBLIC_TOLGEE_API_KEY=tgpk_...
NEXT_PUBLIC_TOLGEE_API_URL=https://app.tolgee.io
DEFAULT_LANGUAGE=fr

# ---------------------------------------------------------------------
# 🤖  IA (optionnel — pour les features d'IA dans ton app)
# ---------------------------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------
# 🐘  POSTGRES (paramètres additionnels pour le service db)
# ---------------------------------------------------------------------
# Active l'extension pgvector dès le démarrage
POSTGRES_INITDB_ARGS=--encoding=UTF-8 --lc-collate=C --lc-ctype=C
