{
  "extends": "@qoe/tsconfig/node.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": false,
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@qoe/db/client": ["../packages/db/src/client.ts"],
      "@qoe/db/*": ["../packages/db/src/*"],
      "@qoe/db": ["../packages/db/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
