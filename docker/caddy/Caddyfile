# =====================================================================
# 🌐 Caddyfile multi-domaine — qoe.fi
# =====================================================================
# 📖 Architecture prod :
#
#    Internet (80, 443)
#         ↓
#      Caddy (TLS auto via Let's Encrypt)
#         ↓
#    ┌────┴─────────────────────────────────────────┐
#    ↓          ↓           ↓         ↓        ↓
#   web      console      api     web (sub)  web (custom)
#  :3000      :3000       :3001     :3000      :3000
#
# 📖 Sous-domaines (v5 — nom de service = sous-domaine) :
#   qoe.fi / www          → core       (reader + auth)
#   hi.qoe.fi             → hi         (marketing / exposition)
#   api.qoe.fi            → api        (backend Go)
#   updates.qoe.fi        → updates    (OTA expo-updates : manifest + assets)
#   studio.qoe.fi         → studio     (dashboard créateur)
#   admin.qoe.fi          → admin      (admin plateforme — TAILNET-ONLY 01/09)
#   *.qoe.fi (wildcard)   → tenants    (blogs créateurs)
#   auth.qoe.fi / cdn.qoe.fi → supabase-kong
#   umami.qoe.fi          → umami (TRACKING public uniquement : /script.js
#                           + /api/send — le dashboard est tailnet-only)
#
# 📖 Sous-domaines ADMIN (tailnet-only, DNS *.admin.qoe.fi → 100.117.195.127
#    via dnsmasq sur l'IP tailnet + split DNS Tailscale) :
#   studio.admin.qoe.fi   → supabase-studio (dashboard Supabase)
#   umami.admin.qoe.fi    → umami (dashboard analytics)
#   mail.admin.qoe.fi     → stalwart (UI admin mail, host:28080)
#   admin.qoe.fi          → admin (admin plateforme, TAILNET-ONLY 01/09)
#   → Certificats HTTP-01 auto par Caddy ; accès restreint aux IP du
#     tailnet (matcher remote_ip) — hors tailnet, connexion FERMÉE (abort) :
#     plus de 404 « Not found » qui révèle l'existence des services. Le DNS
#     public de *.admin.qoe.fi reste sur l'IP du VPS (nécessaire à l'émission/
#     renouvellement des certs) ; l'accès passe par le tailnet via dnsmasq
#     (split DNS Tailscale).
#
# 📖 TLS des tenants (*.qoe.fi) : cert à la demande (on_demand, HTTP-01)
#    par sous-domaine — un cert statique qoe.fi ne matche pas les
#    sous-domaines (⚠️ « connexion non sécurisée » sur ephe.qoe.fi vécu 01/09).
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# ⚙️ OPTIONS GLOBALES
# ─────────────────────────────────────────────────────────────────────
{
    admin off

    # TLS à la demande pour les tenants (*.qoe.fi) : un cert Let's Encrypt
    # HTTP-01 par sous-domaine (ephe.qoe.fi, …), émis au 1er hit puis
    # conservé/renewé par Caddy. Limite LE : 50 certs/semaine → OK pour
    # un petit nombre de tenants. Pas besoin du cert wildcard DNS-01.
    # (Seuls les hosts couverts par un bloc de site déclenchent l'émission —
    # un domaine tiers pointé vers le VPS n'obtient rien.)
    # ⚠️ Caddy ≥ 2.9 : `interval` ET `burst` ont été SUPPRIMÉS (vécu 01/09 :
    # crash-loop au reload). Il ne reste que `ask` (obligatoire) → endpoint
    # interne :8080 (bloc dédié en bas de fichier, port NON publié). Caddy
    # répond 200 pour tout : seuls les hosts couverts par un bloc de site
    # (tous des *.qoe.fi) déclenchent de toute façon l'émission.
    on_demand_tls {
        ask http://localhost:8080/check
    }
}

(qoe_cert) {
    # ⚠️ Chemin -0001 OBLIGATOIRE : certbot a créé live/qoe.fi-0001 (collision
    # avec le live/qoe.fi hérité de la migration du 21/08) et c'est le -0001
    # qu'il RENOUVELLE (conf renewal/qoe.fi-0001.conf). Sans ce chemin, Caddy
    # servirait un cert expiré le 19/11 (diagnostiqué 01/09).
    tls /etc/letsencrypt/live/qoe.fi-0001/fullchain.pem /etc/letsencrypt/live/qoe.fi-0001/privkey.pem
}

(lassez_cert) {
    tls /etc/letsencrypt/live/lassez.fr-0001/fullchain.pem /etc/letsencrypt/live/lassez.fr-0001/privkey.pem
}

(api_lassez_cert) {
    tls /etc/letsencrypt/live/api.lassez.fr/fullchain.pem /etc/letsencrypt/live/api.lassez.fr/privkey.pem
}

# 🛡️ Matcher « tailnet » : IP du tailnet Tailscale (CGNAT 100.64/10 + ULA
#    IPv6). Utilisé par tous les blocs tailnet-only (admin.qoe.fi,
#    *.admin.qoe.fi). ⚠️ Doit être défini AVANT les blocs qui l'importent
#    (pas de forward reference dans le Caddyfile).
(tailnet_guard) {
    @tailnet remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
}

# ─────────────────────────────────────────────────────────────────────
# 🌍 DOMAINE PRINCIPAL : qoe.fi (home + auth + feed)
# ─────────────────────────────────────────────────────────────────────
# Sert : / (home/feed), /login, /library, /highlights, /billing,
#        /settings, /onboarding
qoe.fi, www.qoe.fi {
    import qoe_cert
    encode zstd gzip

    # Headers de sécurité
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # 🔀 Reverse proxy vers core (qui gère home + auth)
    reverse_proxy core:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        transport http {
            dial_timeout 30s
            response_header_timeout 30s
            read_timeout 30s
            write_timeout 30s
        }
    }

    log {
        output stdout
        format console
        level INFO
    }
}


# ─────────────────────────────────────────────────────────────────────
# 🎨 STUDIO CRÉATEUR : studio.qoe.fi
# ─────────────────────────────────────────────────────────────────────
studio.qoe.fi {
    import qoe_cert
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }

    # ⚠️ PIÈGE RÉSEAU (vécu 01/09) : `studio` est un nom DNS AMBIGU sur
    # qoefi-public — supabase-studio porte AUSSI l'alias `studio` (ajouté
    # pour base.admin.qoe.fi). reverse_proxy studio:3000 tombait au hasard
    # sur le dashboard Supabase → redirections /project/default + 404 par
    # intermittence sur studio.qoe.fi. On utilise le nom de container UNIQUE
    # qoefi-studio (le nom de service compose `studio` reste le même).
    reverse_proxy qoefi-studio:3000 {
        transport http {
            dial_timeout 30s
        }
    }

    log {
        output stdout
        format console
    }
}

# ─────────────────────────────────────────────────────────────────────
# 🔴 ADMIN PLATEFORME : admin.qoe.fi — TAILNET-ONLY (depuis 01/09)
# ─────────────────────────────────────────────────────────────────────
# L'admin plateforme n'est PLUS accessible publiquement. Accès :
#   - depuis un appareil du tailnet : https://admin.qoe.fi résolu par le DNS
#     privé dnsmasq → 100.117.195.127 (split DNS Tailscale, cf.
#     scripts/install-tailnet-dns.sh) → DNAT PREROUTING → Caddy (IP source
#     tailnet préservée) → matcher @tailnet → reverse_proxy qoefi-admin.
#     Le nom de domaine reste admin.qoe.fi (aucune URL interne à casser).
#   - depuis Internet : connexion FERMÉE (abort) — plus de 404 « Not found »
#     révélateur.
# ⚠️ Fallback SANS split DNS : http://100.117.195.127:3002 (port publié
#    tailnet-only, voir docker-compose.yml).
admin.qoe.fi {
    import qoe_cert
    import tailnet_guard
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"  # Plus strict pour admin
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
    }

    handle @tailnet {
        reverse_proxy qoefi-admin:3000 {
            transport http {
                dial_timeout 30s
            }
        }
    }
    handle {
        # Hors tailnet : on FERME la connexion (plus de 404 révélateur).
        abort
    }

    log {
        output stdout
        format console
    }
}

# ─────────────────────────────────────────────────────────────────────
# 📣 HI MARKETING : hi.qoe.fi
# ─────────────────────────────────────────────────────────────────────
hi.qoe.fi {
    import qoe_cert
    encode zstd gzip

    # Headers plus permissifs (site public, pas d'auth)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }

    reverse_proxy hi:3000 {
        header_up Host {host}
        transport http {
            dial_timeout 30s
        }
    }

    log {
        output stdout
        format console
    }
}

# ─────────────────────────────────────────────────────────────────────
# 🔌 API : api.qoe.fi → Backend Go (backend-of-record)
# ─────────────────────────────────────────────────────────────────────
api.qoe.fi {
    import qoe_cert
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Access-Control-Allow-Origin "*"
    }

    reverse_proxy api:8080 {
        transport http {
            dial_timeout 60s
            response_header_timeout 60s
        }
    }

    log {
        output stdout
        format console
    }
}

# 📦 UPDATES OTA : updates.qoe.fi → serveur d'updates expo-updates
# ─────────────────────────────────────────────────────────────────────
# Endpoint machine (l'app mobile release appelle /api/manifest et
# /api/assets). Cert on_demand (comme les tenants) : un cert statique
# qoe.fi ne couvre pas les sous-domaines.
updates.qoe.fi {
    tls {
        on_demand
    }
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }

    reverse_proxy updates:3000 {
        transport http {
            dial_timeout 30s
        }
    }

    log {
        output stdout
        format console
    }
}

# ─────────────────────────────────────────────────────────────────────
# 📚 BLOGS CRÉATEURS (WILDCARD) : *.qoe.fi (Tenants)
# ─────────────────────────────────────────────────────────────────────
# Tous les sous-domaines créateurs (ex: jean.qoe.fi) vont vers tenants.
# ⚠️ Cette règle wildcard doit impérativement être après les routes spécifiques
#    (studio.qoe.fi, admin.qoe.fi, start.qoe.fi, api.qoe.fi) pour que Caddy
#    aiguille correctement vers les conteneurs spécifiques en priorité.
*.qoe.fi {
    # Cert à la demande (HTTP-01) PAR sous-domaine. Avant : le cert statique
    # qoe.fi était servi pour TOUS les tenants → mismatch de nom → erreur
    # « connexion non sécurisée » au navigateur (vécu sur ephe.qoe.fi).
    tls {
        on_demand
    }
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy tenants:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        transport http {
            dial_timeout 30s
        }
    }

    log {
        output stdout
        format console
    }
}

# ─────────────────────────────────────────────────────────────────────
# 🌐 DOMAINE CUSTOM (CNAME) : ex. writer.com → tenant sur qoe.fi
# ─────────────────────────────────────────────────────────────────────
# ⚠️ Cette règle catch-all doit être EN DERNIER.
#    Si un host ne match aucun des blocs ci-dessus, c'est un custom domain.
#    → On le route vers tenants (qui résout via subdomain/customDomain).
#    ⚠️ Nécessite que le DNS pointe vers le VPS.
:80 {
    # Catch-all pour custom domains (tout ce qui n'est pas qoe.fi)
    @custom not host qoe.fi www.qoe.fi hi.qoe.fi api.qoe.fi umami.qoe.fi studio.qoe.fi admin.qoe.fi *.admin.qoe.fi
    handle @custom {
        reverse_proxy tenants:3000 {
            header_up Host {host}
            header_up X-Forwarded-Host {host}
        }
    }
}

# ─────────────────────────────────────────────────────────────────────
# 📋 NOTES IMPORTANTES
# ─────────────────────────────────────────────────────────────────────
# 1. Le wildcard *.qoe.fi inclut studio, admin, hi, api ET les tenants.
#    C'est intentionnel : si un sous-domaine n'a pas de route spécifique,
#    il est traité comme un tenant (géré par l'app tenants).
#    ⚠️ Les *.admin.qoe.fi (3 niveaux) ne sont PAS couverts par *.qoe.fi :
#    blocs dédiés tailnet-only (studio/umami/mail.admin.qoe.fi) + admin.qoe.fi
#    (admin plateforme, tailnet-only depuis le 01/09) ; les autres (pooler,
#    kong) restent joignables en direct sur l'IP tailnet
#    (100.117.195.127:<port>) via le DNS dnsmasq + le firewall iptables.
#
# 2. TLS des tenants = certs on_demand (HTTP-01) par sous-domaine, émis
#    par Caddy au premier hit et renewés automatiquement. Alternative
#    « classique » : cert wildcard DNS-01 (provider DNS requis, ex. Hetzner).
#
# 3. Pour le dev local, utilise plutôt :
#    start.localhost, api.localhost, dashboard.localhost, admin.localhost
#    (Caddy génère des certs auto-signés pour ces hosts)
#
# 4. Les blocs @custom en fin de fichier permettent aux custom domains
#    (CNAME) de fonctionner SANS avoir à reconfigurer Caddy.
#    C'est du "any host that's not in our list → tenant".

# ───────────────────────────────────────────────────────────────────
