studio.lassez.fr {
    import lassez_cert
    encode zstd gzip
    reverse_proxy host.docker.internal:4002
    log {
        output stdout
        format console
    }
}

# ───────────────────────────────────────────────────────────────────
# 🐘 SUPABASE API GATEWAY (Kong) - auth.qoe.fi
# ───────────────────────────────────────────────────────────────────
auth.qoe.fi {
    import qoe_cert
    encode zstd gzip
    reverse_proxy supabase-kong:8000
    log {
        output stdout
        format console
    }
}

# ───────────────────────────────────────────────────────────────────
# 📦 SOVEREIGN CDN (Supabase Storage Local Cache) - cdn.qoe.fi
# ───────────────────────────────────────────────────────────────────
cdn.qoe.fi {
    import qoe_cert
    encode zstd gzip
    # Re-write the URL
    rewrite * /storage/v1/object/public{path}
    reverse_proxy supabase-kong:8000
    log {
        output stdout
        format console
    }
}

# ───────────────────────────────────────────────────────────────────
# 💻 SUPABASE STUDIO (Dashboard) via Tailscale + Basic Auth
# ───────────────────────────────────────────────────────────────────
admin-studio.qoe.fi {
    import qoe_cert
    encode zstd gzip

    @tailscale remote_ip 100.64.0.0/10 127.0.0.0/8 172.16.0.0/12
    handle @tailscale {
        basicauth / {
            qoe-admin JDJhJDE0JFB3WHFQVkdhTWRhTnBUZnVESE5reE9jSzEzWHBFYnRDeG93NTcwY29RdklNLkNqNlJ1dnF1
        }
        reverse_proxy supabase-studio:3000
    }
    respond "Access Denied - Private Network Only" 403

    log {
        output stdout
        format console
    }
}
