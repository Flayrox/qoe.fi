# =====================================================================
# 🌐 Caddyfile multi-domaine — qoe.fi
# =====================================================================
# 📖 Architecture prod :
#
#    Internet (80, 443)
#         ↓
#      Caddy (TLS auto via Let's Encrypt)
#         ↓
#    ┌────┴─────────────────────────────────────────┐
#    ↓          ↓           ↓         ↓        ↓
#   web      console      api     web (sub)  web (custom)
#  :3000      :3000       :3001     :3000      :3000
#
# 📖 Wildcard *.qoe.fi nécessite un cert wildcard
#    (DNS-01 challenge). Let's Encrypt le fait gratuitement.
#    ⚠️ Si tu utilises Cloudflare, active le proxy (le cert est auto).
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# ⚙️ OPTIONS GLOBALES
# ─────────────────────────────────────────────────────────────────────
{
    admin off
}

(qoe_cert) {
    tls /etc/letsencrypt/live/qoe.fi/fullchain.pem /etc/letsencrypt/live/qoe.fi/privkey.pem
}

(lassez_cert) {
    tls /etc/letsencrypt/live/lassez.fr-0001/fullchain.pem /etc/letsencrypt/live/lassez.fr-0001/privkey.pem
}

(api_lassez_cert) {
    tls /etc/letsencrypt/live/api.lassez.fr/fullchain.pem /etc/letsencrypt/live/api.lassez.fr/privkey.pem
}

# ─────────────────────────────────────────────────────────────────────
# 🌍 DOMAINE PRINCIPAL : qoe.fi (home + auth + feed)
# ─────────────────────────────────────────────────────────────────────
# Sert : / (home/feed), /login, /library, /highlights, /billing,
#        /settings, /onboarding
qoe.fi, www.qoe.fi {
    import qoe_cert
    encode zstd gzip

    # Headers de sécurité
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # 🔀 Reverse proxy vers feed (qui gère home + auth)
    reverse_proxy feed:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        transport http {
            dial_timeout 30s
            response_header_timeout 30s
            read_timeout 30s
            write_timeout 30s
        }
    }

    log {
        output stdout
        format console
        level INFO
    }
}


# ─────────────────────────────────────────────────────────────────────
# 🟠 DASHBOARD CRÉATEUR : dashboard.qoe.fi
# ─────────────────────────────────────────────────────────────────────
dashboard.qoe.fi {
    import qoe_cert
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }

    reverse_proxy dashboard:3000 {
        transport http {
            dial_timeout 30s
        }
    }

    log {
        output stdout
        format console
    }
}

# ─────────────────────────────────────────────────────────────────────
# 🔴 ADMIN PLATEFORME : admin.qoe.fi
# ─────────────────────────────────────────────────────────────────────
admin.qoe.fi {
    import qoe_cert
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"  # Plus strict pour admin
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
    }

    reverse_proxy admin:3000 {
        transport http {
            dial_timeout 30s
        }
    }

    log {
        output stdout
        format console
    }
}

# ─────────────────────────────────────────────────────────────────────
# 📣 LANDING MARKETING : start.qoe.fi
# ─────────────────────────────────────────────────────────────────────
start.qoe.fi {
    import qoe_cert
    encode zstd gzip

    # Headers plus permissifs (site public, pas d'auth)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }

    reverse_proxy landing:3000 {
        header_up Host {host}
        transport http {
            dial_timeout 30s
        }
    }

    log {
        output stdout
        format console
    }
}

# ─────────────────────────────────────────────────────────────────────
# 🔌 API : api.qoe.fi
# ─────────────────────────────────────────────────────────────────────
api.qoe.fi {
    import qoe_cert
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Access-Control-Allow-Origin "*"
    }

    reverse_proxy api:3001 {
        transport http {
            dial_timeout 60s
            response_header_timeout 60s
        }
    }

    log {
        output stdout
        format console
    }
}

# ─────────────────────────────────────────────────────────────────────
# 📚 BLOGS CRÉATEURS (WILDCARD) : *.qoe.fi (Tenants)
# ─────────────────────────────────────────────────────────────────────
# Tous les sous-domaines créateurs (ex: jean.qoe.fi) vont vers web.
# ⚠️ Cette règle wildcard doit impérativement être après les routes spécifiques
#    (dashboard.qoe.fi, admin.qoe.fi, start.qoe.fi, api.qoe.fi) pour que Caddy
#    aiguille correctement vers les conteneurs spécifiques en priorité.
*.qoe.fi {
    import qoe_cert
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy web:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        transport http {
            dial_timeout 30s
        }
    }

    log {
        output stdout
        format console
    }
}

# ─────────────────────────────────────────────────────────────────────
# 🌐 DOMAINE CUSTOM (CNAME) : ex. writer.com → tenant sur qoe.fi
# ─────────────────────────────────────────────────────────────────────
# ⚠️ Cette règle catch-all doit être EN DERNIER.
#    Si un host ne match aucun des blocs ci-dessus, c'est un custom domain.
#    → On le route vers web (qui résout via subdomain/customDomain).
#    ⚠️ Nécessite que le DNS pointe vers le VPS.
:80 {
    # Catch-all pour custom domains (tout ce qui n'est pas qoe.fi)
    @custom not host qoe.fi www.qoe.fi start.qoe.fi api.qoe.fi dashboard.qoe.fi admin.qoe.fi
    handle @custom {
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Forwarded-Host {host}
        }
    }
}

# ─────────────────────────────────────────────────────────────────────
# 📋 NOTES IMPORTANTES
# ─────────────────────────────────────────────────────────────────────
# 1. Le wildcard *.qoe.fi inclut dashboard, admin, start, api ET les tenants.
#    C'est intentionnel : si un sous-domaine n'a pas de route spécifique,
#    il est traité comme un tenant (géré par la web app).
#
# 2. Let's Encrypt + wildcard nécessite un challenge DNS-01.
#    Caddy le fait automatiquement si tu utilises un provider DNS supporté
#    (Cloudflare, DigitalOcean, AWS Route53, etc.).
#    Voir : https://caddyserver.com/docs/automatic-https#dns-challenge
#
# 3. Pour le dev local, utilise plutôt :
#    start.localhost, api.localhost, dashboard.localhost, admin.localhost
#    (Caddy génère des certs auto-signés pour ces hosts)
#
# 4. Les blocs @custom en fin de fichier permettent aux custom domains
#    (CNAME) de fonctionner SANS avoir à reconfigurer Caddy.
#    C'est du "any host that's not in our list → tenant".

# ───────────────────────────────────────────────────────────────────
# 🇫🇷 LASSEZ FRONTEND : lassez.fr
# ───────────────────────────────────────────────────────────────────
lassez.fr, www.lassez.fr {
    import lassez_cert
    encode zstd gzip
    reverse_proxy host.docker.internal:4000
    log {
        output stdout
        format console
    }
}

# ───────────────────────────────────────────────────────────────────
# ⚙️ LASSEZ API : api.lassez.fr
# ───────────────────────────────────────────────────────────────────
api.lassez.fr {
    import api_lassez_cert
    encode zstd gzip
    reverse_proxy host.docker.internal:4001
    log {
        output stdout
        format console
    }
}

