# ───────────────────────────────────────────────────────────────────
# 🐘 SUPABASE API GATEWAY (Kong) - auth.qoe.fi
# ───────────────────────────────────────────────────────────────────
auth.qoe.fi {
    import qoe_cert
    encode zstd gzip
    reverse_proxy supabase-kong:8000
    log {
        output stdout
        format console
    }
}

# ───────────────────────────────────────────────────────────────────
# 📦 SOVEREIGN CDN (Supabase Storage Local Cache) - cdn.qoe.fi
# ───────────────────────────────────────────────────────────────────
cdn.qoe.fi {
    import qoe_cert
    encode zstd gzip
    # Re-write the URL
    rewrite * /storage/v1/object/public{path}
    reverse_proxy supabase-kong:8000
    log {
        output stdout
        format console
    }
}

# ───────────────────────────────────────────────────────────────────
# 🖥️ DASHBOARDS ADMIN — TAILNET-ONLY (DNS *.admin.qoe.fi → 100.117.195.127)
# ───────────────────────────────────────────────────────────────────
# 📖 Depuis le 2026-09-01 : les dashboards d'admin ne sont PLUS exposés
#    publiquement. Le DNS public de *.admin.qoe.fi pointe vers le tailnet
#    (records A → 100.117.195.127) : seul un appareil du tailnet peut
#    router vers cette IP. Le matcher remote_ip ci-dessous est une 2e
#    barrière (le trafic public arrivant par l'IP publique avec un Host
#    spoofé reçoit une connexion fermée). Caddy est bindé sur l'IP
#    publique ET l'IP tailnet (docker-compose.yml) ; le 443 du tailnet
#    appartient à Caddy (tailscale serve retiré le 2026-09-01).
# ⚠️ Les challenges ACME HTTP-01 sont répondues par Caddy AVANT les
#    matchers de route → les certs se renouvellent même derrière le filtre.
# (Le snippet (tailnet_guard) est défini en haut de fichier, près des
# autres snippets — requis par admin.qoe.fi qui le précède.)

# Supabase Studio (base de données) — tailnet-only
studio.admin.qoe.fi {
    import tailnet_guard
    encode zstd gzip

    handle @tailnet {
        reverse_proxy supabase-studio:3000 {
            transport http {
                dial_timeout 30s
            }
        }
    }
    handle {
        # Hors tailnet : connexion FERMÉE (plus de 404 « Not found » révélateur).
        abort
    }

    log {
        output stdout
        format console
    }
}

# (Supprimé le 01/09 : base.admin.qoe.fi n'a plus de bloc — plus de cert émis
#  pour cet ancien nom de Supabase Studio, remplacé par studio.admin.qoe.fi.)

# Dashboard Umami (analytics) — tailnet-only
umami.admin.qoe.fi {
    import tailnet_guard
    encode zstd gzip

    handle @tailnet {
        reverse_proxy umami:3000 {
            transport http {
                dial_timeout 60s
                response_header_timeout 60s
            }
        }
    }
    handle {
        # Hors tailnet : connexion FERMÉE (plus de 404 « Not found » révélateur).
        abort
    }

    log {
        output stdout
        format console
    }
}

# UI admin Stalwart (mail) — tailnet-only, service host sur 127.0.0.1:28080
# (firewall iptables : seul le tailnet + docker y accèdent, voir
# scripts/tailnet-firewall.sh).
mail.admin.qoe.fi {
    import tailnet_guard
    encode zstd gzip

    handle @tailnet {
        reverse_proxy host.docker.internal:28080 {
            transport http {
                dial_timeout 10s
            }
        }
    }
    handle {
        # Hors tailnet : connexion FERMÉE (plus de 404 « Not found » révélateur).
        abort
    }

    log {
        output stdout
        format console
    }
}

# ───────────────────────────────────────────────────────────────────
# ✅ ENDPOINT INTERNE « ask » pour l'On-Demand TLS (tenants *.qoe.fi)
# ───────────────────────────────────────────────────────────────────
# Caddy interroge http://localhost:8080/check?domain=<host> AVANT d'émettre
# un cert on-demand. On répond 200 systématiquement : de toute façon, seuls
# les hosts couverts par un bloc de site (tous des *.qoe.fi) déclenchent
# l'émission. Port 8080 NON publié → joignable uniquement depuis le conteneur
# (aucune exposition réseau).
:8080 {
    respond "OK" 200
}

# 📊 UMAMI ANALYTICS (self-hosted) : TRACKING public uniquement
# ─────────────────────────────────────────────────────────────────────
# Depuis le 2026-09-01 : le dashboard est tailnet-only (umami.admin.qoe.fi).
# Ce bloc public ne sert QUE ce dont les visiteurs ont besoin :
#   /script.js  → le tracker (chargé par le navigateur)
#   /api/send   → l'endpoint de collecte appelé par le tracker
# Tout le reste (dashboard, /api/*) → 404 en public.
# ⚠️ L'API Go utilise UMAMI_API_URL=http://umami:3000/api (docker interne,
#    plus jamais le chemin public /api).
umami.qoe.fi {
    import qoe_cert
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }

    @tracking path /script.js /api/send
    handle @tracking {
        reverse_proxy umami:3000 {
            transport http {
                dial_timeout 60s
                response_header_timeout 60s
            }
        }
    }
    handle {
        respond "Not found" 404
    }

    log {
        output stdout
        format console
    }
}
