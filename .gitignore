# =====================================================================
# 🚫 .gitignore — qoe.fi monorepo
# =====================================================================

# ─── Dependencies ───────────────────────────────────────────
# Root node_modules (si on garde quelque chose à la racine)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm store
.pnpm-store/

# ─── Testing ─────────────────────────────────────────────────
coverage
.nyc_output

# ─── Next.js ─────────────────────────────────────────────────
.next/
out/
next-env.d.ts

# ⚠️ Plusieurs .next/ dans le monorepo (apps/web, apps/console)
# Le pattern .next/ matche tous les sous-dossiers ✓

# ─── Production builds ───────────────────────────────────────
build/
dist/
*.tsbuildinfo

# ─── Turbo ───────────────────────────────────────────────────
.turbo/

# ─── Misc OS / IDE ───────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ─── Debug logs ──────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Env files (NEVER commit) ────────────────────────────────
.env
.env*
!.env.example
!.env.docker.example

# Local envs par app
apps/*/.env
apps/*/.env.local
packages/*/.env
packages/*/.env.local
workers/.env

# ─── Vercel / Cloudflare ─────────────────────────────────────
.vercel
.wrangler

# ─── Prisma generated ────────────────────────────────────────
src/generated/prisma
packages/db/src/generated
apps/api/src/generated

# ─── Project-specific (legacy) ──────────────────────────────
/.waiting
/.roo
/.gemini
/.agents
/.docs
/.vscode
/.idea

qoefie.psd

# ─── Tests artifacts ────────────────────────────────────────
**/*.test.ts.snap
**/*.test.tsx.snap
.vitest-cache

# Local backup / archives (non-project)
OLD/
POINT git.rar
scripts/zip.ps1
scripts/zip.sh

# ─── Internal planning notes (NOT for public repo) ──────────
# Plan documents & working notes for the team only.
# /plans/ contains drafts, design explorations, internal roadmaps
# that should not be pushed to the public repo.
plans/
gemini-code.html
.reference/
mcp-config.json

# ─── Excluded experimental / work directories ─────────────
jules_2/
# ─── Playwright E2E artifacts ──────────────────────────────
test-results/
playwright-report/
playwright/.auth/
blob-report/

# ─── Freebuff (agent desktop artifacts) ────────────────────
.freebuff/

# ─── Secrets de déploiement (NE PAS committer) ─────────────
.env.docker

# ─── Modèles d'inférence locaux (GGUF) ────────────────────
/models/
