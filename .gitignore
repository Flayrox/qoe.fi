# =====================================================================
# 🚫 .gitignore — qoe.fi monorepo
# =====================================================================

# ─── Dependencies ───────────────────────────────────────────
# Root node_modules (si on garde quelque chose à la racine)
node_modules
package-lock.json
examples/**/node_modules
examples/**/.next
examples/**/next-env.d.ts
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm store
.pnpm-store/

# ─── Testing ─────────────────────────────────────────────────
coverage
.nyc_output

# ─── Next.js ─────────────────────────────────────────────────
.next/
out/
next-env.d.ts

# ⚠️ Plusieurs .next/ dans le monorepo (apps/web, apps/console)
# Le pattern .next/ matche tous les sous-dossiers ✓

# ─── Production builds ───────────────────────────────────────
build/
dist/
*.tsbuildinfo

# ─── Turbo ───────────────────────────────────────────────────
.turbo/

# ─── Misc OS / IDE ───────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ─── Backups (dumps DB générés) ──────────────────────────────
# Les dumps .sql.gz datés (backups/*-*-*.sql.gz) sont des artefacts
# générés par scripts/backup-postgres.sh : jamais versionnés.
backups/*.sql.gz
backups/*.dump*

# ─── Debug logs ──────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Env files (NEVER commit) ────────────────────────────────
.env
.env*
!.env.example
!.env.docker.example

# Local envs par app
apps/*/.env
apps/*/.env.local
packages/*/.env
packages/*/.env.local
workers/.env

# ─── Vercel / Cloudflare ─────────────────────────────────────
.vercel
.wrangler

# ─── Prisma generated ────────────────────────────────────────
src/generated/prisma
packages/db/src/generated
apps/api/src/generated

# ─── Project-specific (legacy) ──────────────────────────────
/.waiting
/.roo
/.gemini
/.agents
/.docs
/.vscode
/.idea

qoefie.psd

# ─── Tests artifacts ────────────────────────────────────────
**/*.test.ts.snap
**/*.test.tsx.snap
.vitest-cache

# Local backup / archives (non-project)
OLD/
POINT git.rar
scripts/zip.ps1
scripts/zip.sh

# ─── Internal planning notes (NOT for public repo) ──────────
# Plan documents & working notes for the team only.
# /plans/ contains drafts, design explorations, internal roadmaps
# that should not be pushed to the public repo.
plans/
gemini-code.html
.reference/
mcp-config.json

# ─── Excluded experimental / work directories ─────────────
jules_2/
# ─── Playwright E2E artifacts ──────────────────────────────
test-results/
playwright-report/
playwright/.auth/
blob-report/

# ─── Agent desktop artifacts (données locales de l'app) ─────
.freebuff/

# ─── Secrets de déploiement (NE PAS committer) ─────────────
.env.docker

# ─── Modèles d'inférence locaux (GGUF) ────────────────────
/models/

# ─── Sauvegardes et scripts premium locaux ─────────────────
# Données de base générées localement, potentiellement volumineuses/sensibles.
backups/premium/
scripts/premium-snapshot.sh
scripts/verify-premium-db.sh

# ─── Fausse DB locale (seed + images) ───────────────────────
# Tout ce qui fabrique notre base fictive reste en local : photos de
# profil scrapées (Pinterest/Commons), catalogue d'avatars, personas,
# scripts de téléchargement. Rien de tout ça n'est commité.
apps/api/internal/seed/assets/avatars/

# outil d'évaluation de la fausse db (recsys-eval)
apps/api/cmd/recsys-eval/
apps/api/recsys-eval

# Bundles OTA expo-updates (bind mount du service docker `updates`)
data/updates/
apps/mobile/.expo-updates/

# Sauvegardes de la fausse DB (dumps pg_dump, souvent volumineux)
backups/top-db-*.sql.gz
backups/umami-*.sql.gz
scripts/fetch-avatars.sh
scripts/fetch-base-avatars.sh
scripts/fetch-gaming-avatars.sh
scripts/fetch-pinterest-avatars.sh
scripts/fetch-themed-avatars.sh
scripts/compress-avatars.sh

# Couvertures thématiques Pinterest — contenu tiers, dev/test local uniquement
apps/api/internal/seed/assets/covers/
