{
  "extends": "@qoe/tsconfig/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "paths": {
      "@qoe/sdk": ["./src/index.ts"],
      "@qoe/sdk/*": ["./src/*"],
      "@qoe/supabase": ["../supabase/src/index.ts"],
      "@qoe/supabase/server": ["../supabase/src/server.ts"],
      "@qoe/supabase/*": ["../supabase/src/*"],
      "@qoe/utils": ["../utils/src/index.ts"],
      "@qoe/utils/*": ["../utils/src/*"],
      "@qoe/ui": ["../ui/src/index.ts"],
      "@qoe/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
