{
  "name": "@qoe/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./sync-user": {
      "types": "./src/sync-user.ts",
      "default": "./src/sync-user.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./repositories/articles": {
      "types": "./src/repositories/articles.ts",
      "default": "./src/repositories/articles.ts"
    },
    "./repositories/users": {
      "types": "./src/repositories/users.ts",
      "default": "./src/repositories/users.ts"
    },
    "./repositories/posts": {
      "types": "./src/repositories/posts.ts",
      "default": "./src/repositories/posts.ts"
    },
    "./repositories/subscriptions": {
      "types": "./src/repositories/subscriptions.ts",
      "default": "./src/repositories/subscriptions.ts"
    },
    "./devtools": {
      "types": "./src/devtools.ts",
      "default": "./src/devtools.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@qoe/observability": "workspace:^",
    "@qoe/supabase": "workspace:*"
  },
  "devDependencies": {
    "@qoe/config": "workspace:*",
    "@qoe/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "prisma": "^6.19.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
