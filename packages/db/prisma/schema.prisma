model ModerationReport {
  id         String   @id @default(cuid())
  reporterId String   @db.Uuid
  reporter   User     @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId   String
  targetType String // "thought" | "article" | "user" | "comment"
  reason     String
  details    String?  @db.Text
  status     String   @default("pending") // "pending" | "reviewed" | "dismissed" | "actioned"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([targetId, targetType])
  @@index([reporterId])
  @@index([status])
}

enum MediaAssetStatus {
  DRAFT_ORPHAN // Uploadé dans TipTap / composer mais pas encore attaché à un contenu sauvegardé (TTL: 3j)
  ATTACHED // Lié à un article, une pensée ou un profil sauvegardé (Actif)
  SOFT_DELETED // Contenu parent supprimé ou image remplacée (Rétention de sécurité : 14j)
  PURGED // Blob physique détruit définitivement du stockage
}

enum MediaAssetTargetType {
  ARTICLE_COVER
  ARTICLE_BODY
  THOUGHT_ATTACHMENT
  USER_AVATAR
  USER_BANNER
  PUBLICATION_LOGO
  PUBLICATION_BANNER
  SHARED
}

model MediaAsset {
  id           String               @id @default(cuid())
  sha256       String               // Hash SHA-256 du contenu pour dédoublonnage CAS
  url          String               @db.Text
  storagePath  String               @db.Text
  bucket       String               @default("articles-media")
  mimeType     String               // "image/webp", "image/avif", "image/png", etc.
  width        Int?
  height       Int?
  sizeBytes    Int                  // Poids du fichier physique
  blurhash     String?              @db.Text // BlurHash pour aperçu instantané à 0ms
  
  // Sécurité & Modération
  isNsfw       Boolean              @default(false)
  isSensitive  Boolean              @default(false)
  safetyScores Json?                // Scores de modération (sexual, violence, hate, etc.)
  moderatedAt  DateTime?
  
  // Cycle de vie & Rétention FinOps
  status       MediaAssetStatus     @default(DRAFT_ORPHAN)
  targetType   MediaAssetTargetType @default(SHARED)
  // Un media a TOUJOURS un propriétaire : userId (upload par un membre) ou
  // publicationId (logo/bannière d'un média). Rendu obligatoire en base.
  ownerId      String
  attachedToId String?              // id de l'article ou de la pensée
  
  purgeDueAt   DateTime?            // Date programmée de purge physique par le cron
  deletedAt    DateTime?            // Date de mise en corbeille
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([sha256])
  @@index([status, purgeDueAt])
  @@index([ownerId])
  @@index([attachedToId])
}

// =====================================================================
// 🔐 OAuth 2.1 / OpenID Connect — fournisseur d'identité qoe.fi
// =====================================================================
enum OAuthClientType {
  CONFIDENTIAL
  PUBLIC
}

enum OAuthClientStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model OAuthClient {
  id               String            @id @default(cuid())
  clientId         String            @unique // identifiant public unique (qoe_oauth_…)
  clientSecretHash String?           // SHA-256 hex du client_secret ; null = client public
  name             String
  description      String?           @db.Text
  logoUrl          String?
  homepageUrl      String?
  redirectUris     String[]          // allowlist exact-match
  scopes           String[]          @default(["openid", "profile", "email"])
  clientType       OAuthClientType   @default(CONFIDENTIAL)
  status           OAuthClientStatus @default(PENDING)
  publicationId    String?           // réservé aux futurs scopes "ressource"
  ownerUserId      String            @db.Uuid
  owner            User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  codes    OAuthAuthorizationCode[]
  tokens   OAuthToken[]
  consents OAuthConsent[]

  @@index([ownerUserId])
  @@index([status])
}

model OAuthAuthorizationCode {
  id                  String       @id @default(cuid())
  codeHash            String       @unique // SHA-256 hex du code, jamais en clair
  clientId            String
  client              OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId              String       @db.Uuid
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri         String       @db.Text
  scopes              String[]
  codeChallenge       String?      // PKCE
  codeChallengeMethod String?      // "S256" | "plain"
  nonce               String?      // OIDC anti-replay (lié à l'id_token)
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime     @default(now())

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
}

model OAuthToken {
  id                    String    @id @default(cuid())
  clientId              String
  client                OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenHash       String    @unique
  refreshTokenHash      String?   @unique
  scopes                String[]
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime?
  revokedAt             DateTime?
  lastUsedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([clientId, userId])
  @@index([refreshTokenHash])
  @@index([accessTokenExpiresAt])
}

model OAuthConsent {
  id        String       @id @default(cuid())
  clientId  String
  client    OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes    String[]
  grantedAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([clientId, userId])
  @@index([userId])
}

