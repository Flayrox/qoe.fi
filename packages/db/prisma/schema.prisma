model Poll {
  id        String   @id @default(cuid())
  thoughtId String   @unique
  thought   Thought  @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  options PollOption[]
  votes   PollVote[]
}

model PollOption {
