{
  "extends": "@qoe/tsconfig/react-library.json",
  "compilerOptions": {
    "rootDir": "..",
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "@qoe/config": ["../config/src/index.ts"],
      "@qoe/config/*": ["../config/src/*"],
      "@qoe/sdk": ["../api-client/src/index.ts"],
      "@qoe/sdk/*": ["../api-client/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
