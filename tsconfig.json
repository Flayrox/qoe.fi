{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Monorepo root",
  "extends": "@qoe/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["*.ts", "*.mts"],
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/.next"]
}
