{
  "name": "qoe.fi",
  "version": "0.1.0",
  "private": true,
  "description": "qoe.fi monorepo — Turborepo + pnpm + Next.js (web, console) + Hono (api) + BullMQ (workers)",
  "scripts": {
    "test": "turbo run test",
    "test:ui": "turbo run test:ui",
    "build": "turbo run build",
    "dev": "node scripts/copy-env.js && turbo run dev --parallel",
    "dev:win": "powershell -ExecutionPolicy Bypass -File scripts/dev-windows.ps1",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:detached": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:web": "docker compose -f docker-compose.dev.yml logs -f web",
    "docker:dev:landing": "docker compose -f docker-compose.dev.yml logs -f landing",
    "docker:dev:feed": "docker compose -f docker-compose.dev.yml logs -f feed",
    "docker:dev:dashboard": "docker compose -f docker-compose.dev.yml logs -f dashboard",
    "docker:dev:admin": "docker compose -f docker-compose.dev.yml logs -f admin",
    "docker:dev:api": "docker compose -f docker-compose.dev.yml logs -f api",
    "docker:dev:shell": "docker compose -f docker-compose.dev.yml exec feed sh",
    "docker:dev:db": "docker compose -f docker-compose.dev.yml exec db psql -U ${POSTGRES_USER:-qoe} -d ${POSTGRES_DB:-qoe}",
    "docker:dev:redis": "docker compose -f docker-compose.dev.yml exec redis redis-cli",
    "docker:dev:studio": "docker compose -f docker-compose.dev.yml up prisma-studio",
    "docker:prod": "docker compose up -d --build",
    "docker:prod:web": "docker compose build --target web && docker compose up -d web",
    "docker:prod:landing": "docker compose build --target landing && docker compose up -d landing",
    "docker:prod:feed": "docker compose build --target feed && docker compose up -d feed",
    "docker:prod:dashboard": "docker compose build --target dashboard && docker compose up -d dashboard",
    "docker:prod:admin": "docker compose build --target admin && docker compose up -d admin",
    "docker:prod:api": "docker compose build --target api && docker compose up -d api",
    "docker:prod:workers": "docker compose build --target workers && docker compose up -d workers",
    "docker:prod:down": "docker compose down",
    "docker:prod:logs": "docker compose logs -f",
    "docker:prod:logs:web": "docker compose logs -f web",
    "docker:prod:logs:landing": "docker compose logs -f landing",
    "docker:prod:logs:feed": "docker compose logs -f feed",
    "docker:prod:logs:dashboard": "docker compose logs -f dashboard",
    "docker:prod:logs:admin": "docker compose logs -f admin",
    "docker:prod:logs:api": "docker compose logs -f api",
    "docker:prod:logs:caddy": "docker compose logs -f caddy",
    "docker:prod:logs:workers": "docker compose logs -f workers",
    "docker:prod:ps": "docker compose ps",
    "docker:prod:rebuild": "docker compose up -d --build --force-recreate",
    "docker:prod:shell": "docker compose exec feed sh",
    "docker:prod:db": "docker compose exec db psql -U ${POSTGRES_USER:-qoe} -d ${POSTGRES_DB:-qoe}",
    "docker:backup": "bash scripts/backup-postgres.sh",
    "docker:seed": "bash scripts/seed-docker.sh",
    "docker:seed:reset": "bash scripts/seed-docker.sh --reset",
    "docker:wait-db": "bash scripts/wait-for-db.sh",
    "docker:deploy": "bash scripts/deploy.sh",
    "prisma:migrate": "cd packages/db && pnpm prisma migrate dev",
    "prisma:generate": "cd packages/db && pnpm prisma generate",
    "prisma:studio": "cd packages/db && pnpm prisma studio",
    "prisma:format": "cd packages/db && pnpm prisma format",
    "prisma:seed": "cd packages/db && pnpm prisma db seed",
    "zip:win": "powershell -ExecutionPolicy Bypass -File scripts/zip.ps1",
    "zip:mac": "bash scripts/zip.sh"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.3.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*{.js,.jsx,.ts,.tsx,.mjs,.cjs,.json,.css}": [
      "prettier --write"
    ],
    "*{.js,.jsx,.ts,.tsx,.mjs,.cjs}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0"
  }
}
