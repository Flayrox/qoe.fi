{
  "name": "qoe.fi",
  "version": "0.1.0",
  "private": true,
  "description": "qoe.fi monorepo — Turborepo + pnpm + Next.js (tenants, core, hi, studio, admin) + Go (api, worker asynq)",
  "scripts": {
    "test": "turbo run test",
    "test:api": "bash scripts/test-api.sh",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "test:ui": "turbo run test:ui",
    "build": "pnpm intl:compile && turbo run build",
    "dev": "node scripts/copy-env.js && pnpm intl:compile && turbo run dev --parallel",
    "dev:up": "./scripts/dev-up.sh",
    "dev:down": "./scripts/dev-down.sh",
    "dev:clean": "bash scripts/dev-clean.sh",
    "kill:dev": "lsof -tiTCP:15401 -sTCP:LISTEN -tiTCP:15402 -sTCP:LISTEN -tiTCP:15403 -sTCP:LISTEN -tiTCP:15404 -sTCP:LISTEN -tiTCP:15405 -sTCP:LISTEN -tiTCP:15406 -sTCP:LISTEN -tiTCP:15407 -sTCP:LISTEN 2>/dev/null | xargs kill 2>/dev/null || true",
    "dev:qoefi": "./scripts/dev-up.sh",
    "dev:qoefi:down": "./scripts/dev-down.sh",
    "dev:qoefi:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "dev:qoefi:ps": "docker compose -f docker-compose.dev.yml ps && lsof -iTCP -sTCP:LISTEN -P | grep -E ':(1540|1541)'",
    "dev:tenants": "node scripts/copy-env.js && pnpm intl:compile && turbo run dev --filter=@qoe/tenants... --parallel",
    "dev:core": "node scripts/copy-env.js && pnpm intl:compile && turbo run dev --filter=@qoe/core... --parallel",
    "dev:hi": "node scripts/copy-env.js && pnpm intl:compile && turbo run dev --filter=@qoe/hi... --parallel",
    "dev:admin": "node scripts/copy-env.js && pnpm intl:compile && turbo run dev --filter=@qoe/admin... --parallel",
    "dev:studio": "node scripts/copy-env.js && pnpm intl:compile && turbo run dev --filter=@qoe/studio... --parallel",
    "dev:mobile": "./scripts/dev-mobile.sh",
    "dev:mobile:ios": "./scripts/dev-mobile.sh --ios",
    "dev:mobile:android": "./scripts/dev-mobile.sh --android",
    "dev:mobile:all": "./scripts/dev-mobile.sh --all",
    "dev:mobile:clean": "./scripts/dev-mobile.sh -c",
    "mobile:start": "pnpm --filter @qoe/mobile start",
    "mobile:ios": "pnpm --filter @qoe/mobile ios",
    "mobile:android": "pnpm --filter @qoe/mobile android",
    "mobile:web": "pnpm --filter @qoe/mobile web",
    "mobile:lint": "pnpm --filter @qoe/mobile lint",
    "mobile:typecheck": "pnpm --filter @qoe/mobile typecheck",
    "mobile:doctor": "pnpm --filter @qoe/mobile exec expo-doctor",
    "dev:win": "powershell -ExecutionPolicy Bypass -File scripts/dev-windows.ps1",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "prepare": "husky",
    "intl:extract": "lingui extract",
    "intl:compile": "lingui compile && prettier --write messages/*.js",
    "intl:build": "lingui extract && pnpm intl:compile",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:detached": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:reset": "docker compose -f docker-compose.dev.yml down && docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:tenants": "docker compose -f docker-compose.dev.yml logs -f tenants",
    "docker:dev:hi": "docker compose -f docker-compose.dev.yml logs -f hi",
    "docker:dev:core": "docker compose -f docker-compose.dev.yml logs -f core",
    "docker:dev:studio": "docker compose -f docker-compose.dev.yml logs -f studio",
    "docker:dev:admin": "docker compose -f docker-compose.dev.yml logs -f admin",
    "docker:dev:shell": "docker compose -f docker-compose.dev.yml exec console sh",
    "docker:dev:db": "docker compose -f docker-compose.dev.yml exec db psql -U ${POSTGRES_USER:-qoe} -d ${POSTGRES_DB:-qoe}",
    "docker:dev:redis": "docker compose -f docker-compose.dev.yml exec redis redis-cli",
    "docker:prod": "docker compose up -d --build",
    "docker:prod:tenants": "docker compose build --target tenants && docker compose up -d tenants",
    "docker:prod:hi": "docker compose build --target hi && docker compose up -d hi",
    "docker:prod:core": "docker compose build --target core && docker compose up -d core",
    "docker:prod:studio": "docker compose build --target studio && docker compose up -d studio",
    "docker:prod:admin": "docker compose build --target admin && docker compose up -d admin",
    "docker:prod:api": "docker compose build api && docker compose up -d api",
    "docker:prod:worker": "docker compose build worker && docker compose up -d worker",
    "docker:prod:down": "docker compose down",
    "docker:prod:logs": "docker compose logs -f",
    "docker:prod:logs:tenants": "docker compose logs -f tenants",
    "docker:prod:logs:hi": "docker compose logs -f hi",
    "docker:prod:logs:core": "docker compose logs -f core",
    "docker:prod:logs:studio": "docker compose logs -f studio",
    "docker:prod:logs:admin": "docker compose logs -f admin",
    "docker:prod:logs:caddy": "docker compose logs -f caddy",
    "docker:prod:logs:worker": "docker compose logs -f worker",
    "docker:prod:logs:api": "docker compose logs -f api",
    "docker:prod:ps": "docker compose ps",
    "docker:prod:rebuild": "docker compose up -d --build --force-recreate",
    "docker:prod:shell": "docker compose exec console sh",
    "docker:prod:db": "docker compose exec db psql -U ${POSTGRES_USER:-qoe} -d ${POSTGRES_DB:-qoe}",
    "docker:backup": "bash scripts/backup-postgres.sh",
    "docker:seed": "bash scripts/seed-docker.sh",
    "docker:seed:reset": "bash scripts/seed-docker.sh --reset",
    "premium:seed": "bash scripts/premium-snapshot.sh seed",
    "premium:verify": "bash scripts/premium-snapshot.sh verify",
    "premium:snapshot": "bash scripts/premium-snapshot.sh snapshot",
    "premium:restore": "bash scripts/premium-snapshot.sh restore",
    "docker:wait-db": "bash scripts/wait-for-db.sh",
    "docker:deploy": "bash scripts/deploy.sh",
    "db:migrate": "cd apps/api && go run ./cmd/migrate up",
    "db:migrate:status": "cd apps/api && go run ./cmd/migrate status",
    "db:seed": "cd apps/api && go run ./cmd/seed",
    "test:db:up": "bash scripts/test-db.sh up",
    "test:db:migrate": "bash scripts/test-db.sh migrate",
    "test:db:status": "bash scripts/test-db.sh status",
    "test:db": "bash scripts/test-db.sh test",
    "test:db:reset": "bash scripts/test-db.sh reset"
  },
  "devDependencies": {
    "@lingui/cli": "^6.6.0",
    "@lingui/format-po": "6.6.0",
    "@lingui/swc-plugin": "^6.6.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.3.0",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*{.js,.jsx,.ts,.tsx,.mjs,.cjs,.json,.css}": [
      "prettier --write"
    ],
    "*{.js,.jsx,.ts,.tsx,.mjs,.cjs}": [
      "eslint --fix"
    ]
  }
}
